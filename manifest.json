{
  "manifest_version": 3,
  "name": "Skribbl.io Word Assist",
  "version": "1.1.1",
  "description": "Shows matching word suggestions for skribbl.io based on word length, revealed letters, and spaces.",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "resources/icons/icon-16.png",
    "32": "resources/icons/icon-32.png",
    "48": "resources/icons/icon-48.png",
    "128": "resources/icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://skribbl.io/*", "https://www.skribbl.io/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Skribbl.io Word Assist",
    "default_icon": {
      "16": "resources/icons/icon-16.png",
      "32": "resources/icons/icon-32.png"
    }
  }
}
